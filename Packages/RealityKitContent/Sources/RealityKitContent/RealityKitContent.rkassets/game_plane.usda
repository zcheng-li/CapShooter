    {
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (-0.44785926, 0, -0.1369225)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "glass_bottle_1" (
        active = true
        customData = {
            float3 rotationEulerHint = (0, 1.68099, 0)
        }
